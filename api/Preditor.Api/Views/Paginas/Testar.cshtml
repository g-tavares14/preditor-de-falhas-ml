@model TestarViewModel
@{
    ViewData["Titulo"] = "Testar o modelo";
    var entrada = Model.Entrada;
    // O valor atual de uma coluna, no formato de um <input type=number> (ponto decimal, vazio = ausente).
    string Valor(string propriedade) =>
        entrada is not null && typeof(Medicao).GetProperty(propriedade)!.GetValue(entrada) is double v
            ? v.ToString(System.Globalization.CultureInfo.InvariantCulture) : "";
}
<h1>Testar o modelo</h1>
<p class="sub">Informe as métricas de uma rota agora; a Random Forest prevê a classe <strong>12 minutos à frente</strong>. Campo vazio = valor ausente (o modelo aceita).</p>

@if (Model.Falha is not null)
{
    <div class="aviso" role="alert">O serviço do modelo não respondeu: @Model.Falha Nada foi gravado.</div>
}

@if (Model.Resultado is { } r)
{
    <section class="cartao" aria-live="polite">
        <p>Previsão para daqui a 12 minutos: <span class="classe classe-@r.Classe">@r.Classe</span></p>
        @foreach (var (nome, valor) in new[] { ("OK", r.ProbOk), ("RISCO", r.ProbRisco), ("FALHA", r.ProbFalha) })
        {
            <div class="barra classe-@nome">
                <span class="nome">@nome</span>
                <span class="trilho"><span class="cheio" style="display:block;width:@((valor * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                <span>@((valor * 100).ToString("0.0"))%</span>
            </div>
        }
        <p class="sha">Modelo (SHA-256): @r.ModeloSha256</p>
    </section>
}

<form method="post" class="cartao">
    @Html.AntiForgeryToken()
    <p class="exemplos">Exemplos:
        @foreach (var (chave, exemplo) in ColunasDoModelo.Exemplos)
        {
            <a href="/testar?exemplo=@chave">@exemplo.Titulo</a>@: &nbsp;
        }
    </p>
    <div class="grade">
        @foreach (var c in ColunasDoModelo.Todas)
        {
            <label>
                @c.Titulo <small>@c.Ajuda</small>
                <input type="number" name="@c.Propriedade" step="@c.Passo" value="@Valor(c.Propriedade)">
                @if (Model.Erros is { } erros && erros.TryGetValue(c.NomeNoModelo, out var mensagens))
                {
                    <span class="erro-campo">@string.Join(" ", mensagens)</span>
                }
            </label>
        }
    </div>
    <div class="acoes">
        <button type="submit">Prever</button>
        <span class="sub" style="margin:0">Cada previsão fica no <a href="/historico">histórico</a>.</span>
    </div>
</form>
