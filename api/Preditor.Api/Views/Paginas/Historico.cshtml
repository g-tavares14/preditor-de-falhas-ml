@model HistoricoViewModel
@{
    ViewData["Titulo"] = "Histórico";
    string Numero(double? v) => v is double x ? x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "—";
}
<h1>Histórico de previsões</h1>
<p class="sub">@Model.Total @(Model.Total == 1 ? "previsão" : "previsões") guardadas, da mais nova para a mais antiga.</p>

@if (Model.Total == 0)
{
    <p class="cartao">Ainda não há previsões. Faça a primeira em <a href="/testar">Testar o modelo</a>.</p>
}
else
{
    <div class="cartao rolagem">
        <table>
            <thead>
            <tr><th>Quando (UTC)</th><th>Classe</th><th>OK</th><th>RISCO</th><th>FALHA</th><th>z</th><th>Aumento %</th><th>Perda %</th><th>Origem</th></tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Itens)
            {
                <tr>
                    <td>@p.CriadaEmUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td><span class="classe classe-@p.Classe">@p.Classe</span></td>
                    <td>@((p.ProbOk * 100).ToString("0.0"))%</td>
                    <td>@((p.ProbRisco * 100).ToString("0.0"))%</td>
                    <td>@((p.ProbFalha * 100).ToString("0.0"))%</td>
                    <td>@Numero(p.ZRobusto)</td>
                    <td>@Numero(p.AumentoPct)</td>
                    <td>@Numero(p.PerdaPct)</td>
                    <td>@p.Origem</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="paginas">
        @if (Model.Pagina > 1) { <a href="/historico?pagina=@(Model.Pagina - 1)">← Mais novas</a> }
        <span>Página @Model.Pagina de @Model.TotalDePaginas</span>
        @if (Model.Pagina < Model.TotalDePaginas) { <a href="/historico?pagina=@(Model.Pagina + 1)">Mais antigas →</a> }
    </div>
}
